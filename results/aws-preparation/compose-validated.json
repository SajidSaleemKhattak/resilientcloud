{
  "name": "resilientcloud-aws-check",
  "networks": {
    "app": {
      "name": "resilientcloud-aws-check_app",
      "ipam": {},
      "internal": true
    },
    "edge": {
      "name": "resilientcloud-aws-check_edge",
      "ipam": {}
    },
    "status-read": {
      "name": "resilientcloud-aws-check_status-read",
      "ipam": {},
      "internal": true
    },
    "web": {
      "name": "resilientcloud-aws-check_web",
      "ipam": {},
      "internal": true
    }
  },
  "services": {
    "backend-a": {
      "build": {
        "context": "/Users/sajid/Projects/resilientcloud",
        "dockerfile": "Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": null,
      "entrypoint": null,
      "environment": {
        "FAULT_INJECTION_ENABLED": "false",
        "INSTANCE_ID": "backend-a",
        "PORT": "3000"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "1s",
        "interval": "2s",
        "retries": 2,
        "start_period": "2s"
      },
      "image": "resilientcloud-backend:aws",
      "labels": {
        "io.resilientcloud.role": "backend"
      },
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "134217728",
      "networks": {
        "app": null
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "backend-b": {
      "build": {
        "context": "/Users/sajid/Projects/resilientcloud",
        "dockerfile": "Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": null,
      "entrypoint": null,
      "environment": {
        "FAULT_INJECTION_ENABLED": "false",
        "INSTANCE_ID": "backend-b",
        "PORT": "3000"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "timeout": "1s",
        "interval": "2s",
        "retries": 2,
        "start_period": "2s"
      },
      "image": "resilientcloud-backend:aws",
      "labels": {
        "io.resilientcloud.role": "backend"
      },
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "134217728",
      "networks": {
        "app": null
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "controller": {
      "build": {
        "context": "/Users/sajid/Projects/resilientcloud",
        "dockerfile": "recovery/Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": [
        "node",
        "recovery/controller.mjs"
      ],
      "depends_on": {
        "gate": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "COOLDOWN_MS": "2000",
        "DATA_DIR": "/data",
        "FAILURE_THRESHOLD": "3",
        "GATE_SOCKET": "/run/gate/gate.sock",
        "GATE_TIMEOUT_MS": "14000",
        "MAX_RESTART_ATTEMPTS": "2",
        "PROBE_INTERVAL_MS": "500",
        "PROBE_TIMEOUT_MS": "300",
        "RECOVERY_ENABLED": "true",
        "VERIFY_TIMEOUT_MS": "4000"
      },
      "image": "resilientcloud-recovery:aws",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "134217728",
      "networks": {
        "app": null
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "gate-runtime",
          "target": "/run/gate",
          "read_only": true,
          "volume": {}
        },
        {
          "type": "volume",
          "source": "controller-data",
          "target": "/data",
          "volume": {}
        }
      ]
    },
    "gate": {
      "build": {
        "context": "/Users/sajid/Projects/resilientcloud",
        "dockerfile": "recovery/Dockerfile"
      },
      "cap_add": [
        "CHOWN"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": [
        "node",
        "recovery/gate-server.mjs"
      ],
      "entrypoint": null,
      "environment": {
        "APP_NETWORK": "resilientcloud-aws-check_app",
        "DATA_DIR": "/audit",
        "PROJECT_DIRECTORY": "/Users/sajid/Projects/resilientcloud",
        "PROJECT_NAME": "resilientcloud-aws-check"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "process.exit(require('node:fs').statSync('/run/gate/gate.sock').isSocket()?0:1)"
        ],
        "timeout": "1s",
        "interval": "1s",
        "retries": 10
      },
      "image": "resilientcloud-recovery:aws",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "134217728",
      "network_mode": "none",
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "user": "0:0",
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "gate-runtime",
          "target": "/run/gate",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "gate-data",
          "target": "/audit",
          "volume": {}
        }
      ]
    },
    "gateway": {
      "cpus": 0.5,
      "command": null,
      "depends_on": {
        "backend-a": {
          "condition": "service_healthy",
          "required": true
        },
        "backend-b": {
          "condition": "service_healthy",
          "required": true
        },
        "status": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": [
        "nginx",
        "-g",
        "daemon off;"
      ],
      "image": "nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "67108864",
      "networks": {
        "app": null,
        "status-read": null,
        "web": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "8080",
          "protocol": "tcp"
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run",
        "/tmp"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/Users/sajid/Projects/resilientcloud/nginx/dashboard.conf",
          "target": "/etc/nginx/nginx.conf",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/Users/sajid/Projects/resilientcloud/nginx/two.conf",
          "target": "/etc/nginx/upstream.conf",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/Users/sajid/Projects/resilientcloud/dashboard/dist",
          "target": "/usr/share/nginx/html",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    },
    "https": {
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": null,
      "depends_on": {
        "gateway": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ACME_EMAIL": "operator@example.com",
        "DEMO_DOMAIN": "demo.example.com"
      },
      "image": "caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "134217728",
      "networks": {
        "edge": null,
        "web": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        }
      ],
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:size=16m"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/Users/sajid/Projects/resilientcloud/deploy/aws/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "tls-data",
          "target": "/data",
          "volume": {}
        }
      ]
    },
    "status": {
      "build": {
        "context": "/Users/sajid/Projects/resilientcloud",
        "dockerfile": "recovery/Dockerfile"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": [
        "node",
        "recovery/status.mjs"
      ],
      "entrypoint": null,
      "environment": {
        "DATA_DIR": "/data"
      },
      "image": "resilientcloud-recovery:aws",
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "134217728",
      "networks": {
        "status-read": null
      },
      "pull_policy": "never",
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "controller-data",
          "target": "/data",
          "read_only": true,
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "controller-data": {
      "name": "resilientcloud-aws-check_controller-data"
    },
    "gate-data": {
      "name": "resilientcloud-aws-check_gate-data"
    },
    "gate-runtime": {
      "name": "resilientcloud-aws-check_gate-runtime"
    },
    "tls-data": {
      "name": "resilientcloud-aws-check_tls-data"
    }
  },
  "x-backend": {
    "build": ".",
    "cap_drop": [
      "ALL"
    ],
    "cpus": 0.5,
    "healthcheck": {
      "interval": "2s",
      "retries": 2,
      "start_period": "2s",
      "test": [
        "CMD",
        "node",
        "-e",
        "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      ],
      "timeout": "1s"
    },
    "image": "resilientcloud-backend:m1",
    "labels": {
      "io.resilientcloud.role": "backend"
    },
    "mem_limit": "128m",
    "networks": [
      "app"
    ],
    "read_only": true,
    "restart": "no",
    "security_opt": [
      "no-new-privileges:true"
    ]
  },
  "x-logs": {
    "driver": "local",
    "options": {
      "max-file": "3",
      "max-size": "10m"
    }
  },
  "x-recovery": {
    "build": {
      "context": ".",
      "dockerfile": "recovery/Dockerfile"
    },
    "cap_drop": [
      "ALL"
    ],
    "cpus": 0.5,
    "image": "resilientcloud-recovery:m2",
    "mem_limit": "128m",
    "read_only": true,
    "restart": "no",
    "security_opt": [
      "no-new-privileges:true"
    ]
  }
}
